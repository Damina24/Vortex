# VORTEX AI Service — environment configuration
# Copy to .env and fill in your values.

# === LLM Providers ===
# Set at least one provider key. When MOCK_LLM=true, deterministic offline
# responses are used (development/testing only).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# === Optional model overrides ===
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# === Offline mode ===
MOCK_LLM=false