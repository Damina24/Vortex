# VORTEX AI — Environment Configuration
# Copy this file to .env and fill in your values

# === Database ===
DATABASE_URL="postgresql://vortex:vortex@localhost:5432/vortex_ai?schema=public"

# === Redis ===
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# === Next Auth ===
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-change-in-production"

# === OAuth Providers ===
# Server-side (used by NextAuth)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Client-side (used to show OAuth buttons)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
NEXT_PUBLIC_GITHUB_CLIENT_ID=""

# === AI Service ===
AI_SERVICE_URL="http://localhost:8000"

# === LLM Providers ===
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# === Video Generation APIs ===
KLING_API_KEY=""
KLING_API_SECRET=""
KLING_MODEL=""
RUNWAY_API_KEY=""
RUNWAY_VIDEO_MODEL=""
WAN_API_KEY=""
WAN_MODEL=""
HAILUO_API_KEY=""
HAILUO_MODEL=""
# Selects the video render provider. `mock` (SVG poster) is the offline default;
# `kling`/`runway`/`hailuo`/`wan` use third-party text-to-video APIs; `ffmpeg` renders a real
# local MP4 (see DEPLOY.md) and requires ffmpeg on PATH or FFMPEG_PATH.
VIDEO_PROVIDER="mock"
# FFmpeg local renderer options (used when VIDEO_PROVIDER=ffmpeg)
FFMPEG_PATH=""
FFMPEG_RENDER_DELAY_MS="1500"

# === Audio Generation APIs ===
# Selects the audio generation provider. `mock` (silent WAV) is the offline
# default; `openai`/`elevenlabs` are real TTS voiceovers; `suno` generates real
# music tracks via an async two-phase API (see DEPLOY.md).
AUDIO_PROVIDER="mock"
ELEVENLABS_API_KEY=""
ELEVENLABS_MODEL=""
ELEVENLABS_VOICE_ID=""
SUNO_API_KEY=""
SUNO_MODEL=""

# === Image Generation ===
# Selects the image generation provider. `mock` (SVG poster) is the offline
# default; `stability` generates a real PNG synchronously; `flux` submits
# through an async two-phase generation gateway (see DEPLOY.md).
IMAGE_PROVIDER="mock"
# Simulate generation latency in mock mode (ms) when IMAGE_PROVIDER=mock.
MOCK_IMAGE_DELAY_MS="80"
STABILITY_API_KEY=""
FLUX_API_KEY=""
FLUX_MODEL="flux-schnell"

# === Storage (AWS S3 or compatible) ===
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET="vortex-assets"
S3_PUBLIC_URL="http://localhost:9000/vortex-assets"

# === Stripe (Billing) ===
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# === Platform Publishing APIs ===
# Publishing is feature-gated and offline-friendly: providers resolve through
# PUBLISHING_PROVIDER (mock by default). The real YouTube provider only needs a
# short-lived access token; refresh/obtaining is handled by your auth layer.
PUBLISHING_PROVIDER="mock"
YOUTUBE_ACCESS_TOKEN=""
TIKTOK_ACCESS_TOKEN=""
META_ACCESS_TOKEN=""
META_PAGE_ID=""
META_APP_ID=""
META_APP_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""

# === Email ===
RESEND_API_KEY=""
EMAIL_FROM="noreply@vortex-ai.com"

# === Rate Limiting ===
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# === Feature Flags ===
NEXT_PUBLIC_ENABLE_ANALYTICS="false"
NEXT_PUBLIC_ENABLE_PUBLISHING="false"
NEXT_PUBLIC_ENABLE_TEAMS="false"